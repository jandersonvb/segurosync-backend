# Configurações do Servidor NestJS
PORT=4000
NODE_ENV=development

# Conexão com o Banco de Dados PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/segurosync_db?schema=public"

# Redis para filas assíncronas do BullMQ (Multicálculo paralelo & Conciliação em lote)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT & Segurança
JWT_SECRET="segurosync_super_secret_jwt_token_2026"
INTERNAL_SERVICE_TOKEN="token_comunicacao_interna_nextjs_nestjs"

# Credenciais das APIs de Seguradoras (Ambiente Sandbox / Homologação SUSEP)
PORTO_SEGURO_CLIENT_ID="sua_chave_porto_aqui"
PORTO_SEGURO_CLIENT_SECRET="seu_secret_porto_aqui"
BRADESCO_SEGUROS_API_KEY="sua_chave_bradesco_aqui"
TOKIO_MARINE_API_KEY="sua_chave_tokio_aqui"
ALLIANZ_API_KEY="sua_chave_allianz_aqui"

# Integração CRM & Mensageria
WHATSAPP_CLOUD_API_TOKEN="token_meta_whatsapp_cloud_api"
RD_STATION_API_KEY="sua_chave_rd_station"
